# DashScope API 配置（必填）：https://bailian.console.aliyun.com/ 获取
DASHSCOPE_API_KEY=sk-你的key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 模型配置
# 注意：已有知识库基于 text-embedding-v2 构建，切换 Embedding 模型需删除 chroma_db/ 重建
LLM_MODEL=qwen-plus
EMBEDDING_MODEL=text-embedding-v3

# 多场景离线演示：true 时 /ask 使用本地条款检索，不调用外部模型
FINANCE_OFFLINE_DEMO=true
# MCP 演示通道最小角色范围；预算/对账工具另要求 manager
MCP_ALLOWED_ROLES=employee,manager
