# DashScope 兼容接口；真实 Key 只写入本地 .env，不要提交或发给他人。
DASHSCOPE_API_KEY=sk-你的key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 统一平台默认离线运行：使用本地条款检索和确定性业务规则，不调用外部模型。
FINANCE_OFFLINE_DEMO=true

# 在线统一知识 RAG：完成真实向量索引构建后，再取消下面一行的注释。
# FINANCE_RETRIEVAL_MODE=vector
FINANCE_EMBEDDING_MODEL=text-embedding-v2
FINANCE_LLM_MODEL=qwen-plus
FINANCE_GENERATION_ENABLED=true
FINANCE_ENABLE_RERANK=true

# MCP 演示通道最小角色范围；预算/对账工具另要求 manager。
MCP_ALLOWED_ROLES=employee,manager
