# 企业财务智能体环境配置样例；请复制为本地 .env，不要提交真实 Key。

# OpenAI 兼容 LLM 网关（DashScope、企业网关、vLLM、Ollama 均可）
FINANCE_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
FINANCE_LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
FINANCE_LLM_MODEL=qwen-plus
FINANCE_LLM_SMALL_MODEL=qwen-flash
FINANCE_LLM_FALLBACK_MODEL=qwen-flash
FINANCE_MODEL_ROUTING_ENABLED=true

# 百炼兼容配置；未设置 FINANCE_LLM_API_KEY 时可复用此 Key 与网关
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxx
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
FINANCE_EMBEDDING_MODEL=text-embedding-v2

# 默认离线演示：不调用模型，使用关键词检索和规则引擎
FINANCE_OFFLINE_DEMO=true
FINANCE_RETRIEVAL_MODE=lexical
FINANCE_GENERATION_ENABLED=false
FINANCE_AGENT_ENABLED=false
FINANCE_ENABLE_RERANK=false

# 在线模式参考：FINANCE_OFFLINE_DEMO=false、FINANCE_RETRIEVAL_MODE=vector、
# FINANCE_GENERATION_ENABLED=true、FINANCE_AGENT_ENABLED=true。
# 切换 embedding 模型后必须执行 python scripts/build_vector_store.py 重建索引。
